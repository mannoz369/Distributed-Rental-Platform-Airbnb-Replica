<% layout("layouts/boilerplate")%>

<div class="row mt-4 bookings-page">
  <div class="col-10 offset-1 bookings-shell">
    <h3>My bookings</h3>
    <% if(bookings.length === 0) { %>
      <p class="text-muted mt-3">You have not booked any stays yet.</p>
    <% } %>
    <div class="row mt-3">
      <% for(let booking of bookings) { %>
        <% const totals = bookingTotals.get(booking._id.toString()); %>
        <div class="card col-md-5 ms-2 mb-3 booking-card">
          <div class="card-body p-3">
            <div class="booking-card-head">
              <h5 class="card-title mb-0"><%= booking.listing ? booking.listing.title : "Deleted listing" %></h5>
              <span class="badge <%= booking.status === "confirmed" ? "text-bg-success" : "text-bg-secondary" %>"><%= booking.status %></span>
            </div>
            <% if(booking.listing) { %>
              <p class="text-muted"><%= booking.listing.location %>, <%= booking.listing.country %></p>
            <% } %>
            <p><b>Dates:</b> <%= booking.checkIn.toLocaleDateString("en-IN") %> - <%= booking.checkOut.toLocaleDateString("en-IN") %></p>
            <p><b>Stay subtotal:</b> &#8377; <%= totals.subtotalPrice.toLocaleString("en-IN") %></p>
            <p><b>GST (18%):</b> &#8377; <%= totals.gstAmount.toLocaleString("en-IN") %></p>
            <p><b>Total:</b> &#8377; <%= totals.totalPrice.toLocaleString("en-IN") %></p>
            <% if(booking.status === "confirmed") { %>
              <a href="/bookings/<%= booking._id %>/cancel" class="btn btn-sm edit-btn booking-cancel-btn">Cancel booking</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
